#!/usr/bin/env python3
"""
sanitize-keyrings:
Inspects all .keyring files in ~/.local/share/keyrings/ and ensures that no
field (such as multi-line JSON secrets written by Flutter / third-party apps)
spans multiple lines without proper formatting, which crashes gnome-keyring-daemon.
"""

import os
import re
import sys
import glob

KEYRINGS_DIR = os.path.expanduser("~/.local/share/keyrings")

def sanitize_keyring_file(filepath):
    if not os.path.isfile(filepath):
        return False

    with open(filepath, "r", encoding="utf-8", errors="replace") as f:
        lines = f.readlines()

    modified = False
    new_lines = []
    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if re.match(r"^[a-zA-Z0-9_\-]+=", stripped) and not stripped.startswith("["):
            key, val = stripped.split("=", 1)
            buffer = [val]
            j = i + 1
            while j < len(lines):
                next_line = lines[j].strip()
                if not next_line or next_line.startswith("[") or re.match(r"^[a-zA-Z0-9_\-]+=", next_line):
                    break
                buffer.append(next_line)
                j += 1

            if len(buffer) > 1:
                joined_val = " ".join(part for part in buffer if part)
                try:
                    import json
                    parsed = json.loads(joined_val)
                    joined_val = json.dumps(parsed)
                except Exception:
                    pass
                new_lines.append(f"{key}={joined_val}\n")
                modified = True
                i = j
                continue

        new_lines.append(line)
        i += 1

    if modified:
        tmp_path = filepath + ".tmp"
        with open(tmp_path, "w", encoding="utf-8") as f:
            f.writelines(new_lines)
        os.replace(tmp_path, filepath)
        return True

    return False

def main():
    if not os.path.isdir(KEYRINGS_DIR):
        return 0

    keyring_files = glob.glob(os.path.join(KEYRINGS_DIR, "*.keyring"))
    for kf in keyring_files:
        if sanitize_keyring_file(kf):
            print(f"[sanitize-keyrings] Fixed multiline format in {kf}")

    return 0

if __name__ == "__main__":
    sys.exit(main())
